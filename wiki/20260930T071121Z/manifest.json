      "deck": "The ordered pipeline, history predicates, effects, and cancellation semantics."
    },
    {
      "slug": "messages",
      "title": "Conversation & event contracts",
      "deck": "Roles, visibility, streaming identity, tool correlation, and wire serialization."
    },
    {
      "slug": "providers",
      "title": "Providers & inference APIs",
      "deck": "Trait contracts, adapters, metadata, retries, and local or delegated inference."
    },
    {
      "slug": "extensions",
      "title": "MCP extensions & tool execution",
      "deck": "Discovery, namespaces, cache races, dispatch, approvals, and code mode."
    },
    {
      "slug": "context",
      "title": "Context management & compaction algorithms",
      "deck": "Trigger arithmetic, protected turns, summaries, and preserved transcripts."
    },
    {
      "slug": "storage",
      "title": "Persistence, sessions & concurrency",
      "deck": "SQLite storage, effect application, usage ledgers, and race boundaries."
    },
    {
      "slug": "security",
      "title": "Permissions, hooks & trust boundaries",
      "deck": "What the approval pipeline enforces, and where its guarantees end."
    },
    {
      "slug": "recipes",
      "title": "Recipes, skills & agent orchestration",
      "deck": "Declarative tasks, parameter contracts, retries, and delegated sessions."
    },
    {
      "slug": "desktop",
      "title": "Desktop, CLI & client lifecycle",
      "deck": "Electron boundaries, ACP connection recovery, and session presentation."
    },
    {
      "slug": "algorithms",
      "title": "Important algorithms: detailed walkthroughs",
      "deck": "Step selection, streaming, edit safety, graph traversal, caching, and runtime cleanup."
    },
    {
      "slug": "patterns",
      "title": "Brilliant code & design patterns",
      "deck": "A curated reading list with the benefit, evidence, and limitation of each choice."
    },
    {
      "slug": "apis",
      "title": "API & protocol reference",
      "deck": "ACP transport, custom methods, Rust extension points, and language bindings."
    },
    {
      "slug": "engineering",
